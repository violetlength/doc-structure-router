{
  "llm": {
    "provider": "openai",
    "model": "deepseek/deepseek-v4-flash-0731:free",
    "api_key": "",
    "base_url": "https://openrouter.ai/api/v1",
    "temperature": 0.7,
    "max_tokens": 4096,
    "timeout": 60
  },
  "ocr": {
    "engine": "paddle",
    "lang": "ch",
    "dpi": 200,
    "use_gpu": false
  },
  "vector_db": {
    "type": "chromadb",
    "path": "./data/chroma_db",
    "collection": "documents"
  },
  "analysis": {
    "sample_pages": 50,
    "chunk_size": 800,
    "chunk_overlap": 150
  }
}
